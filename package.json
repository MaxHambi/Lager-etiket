{
  "name": "lager-etiket-monorepo",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:cli": "pnpm --filter @lager-etiket/cli dev",
    "dev:web": "pnpm --filter @lager-etiket/web dev",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint . --fix && oxfmt .",
    "fmt": "oxfmt .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "etiket": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "^3.2.4",
    "oxfmt": "^0.17.0",
    "oxlint": "^1.29.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
