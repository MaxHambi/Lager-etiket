{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@lager-etiket/lib": ["../lager-etiket/src/index.ts"],
      "@lager-etiket/lib/*": ["../lager-etiket/src/*"],
      "@lager-etiket/compose": ["../compose/src/index.ts"],
