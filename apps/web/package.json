{
  "name": "@lager-etiket/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/gen-vault-stub.mjs && node build.mjs",
    "build:watch": "node build.mjs --watch",
    "typecheck": "node ../../scripts/gen-vault-stub.mjs && tsc --noEmit",
    "lint": "eslint --config ../../eslint.config.js src/",
    "test": "node --test test/*.test.mjs",
    "docs": "node ../../scripts/gen-vault-stub.mjs && typedoc",
    "dev": "node build.mjs --watch"
  },
  "dependencies": {
    "@lager-etiket/core": "*",
    "@lager-etiket/types": "*",
    "@lager-etiket/ui": "*",
    "jsbarcode": "^3.12.3"
  },
  "devDependencies": {
    "@types/jsbarcode": "^3.11.4",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0"
  }
}
